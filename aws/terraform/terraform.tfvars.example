# Copy to terraform.tfvars and fill in. That file is gitignored — it holds secrets.
#
#   cp terraform.tfvars.example terraform.tfvars

region      = "ap-southeast-1"
bucket_name = "lloydrosales-aws-site" # must be globally unique

# Leave empty on the FIRST apply to get everything working on the default
# *.cloudfront.net domain. Then set it, add the CNAMEs from
# `terraform output acm_validation` in Vercel's DNS, and apply again.
domain_name = ""
# domain_name = "aws.lloydrosales.com"

gemini_api_key  = "..."
github_token    = "..."
github_username = "Rozuuuuu"
